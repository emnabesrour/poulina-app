# ===========================================
# Configuration mailing Gmail (optionnel)
# ===========================================
# 1. Compte Google → Sécurité → Validation en 2 étapes (activée)
# 2. Créer un "Mot de passe d'application"
# 3. Remplir les champs ci-dessous puis relancer: npm start

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=ton.email@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=Gestion Materiel Poulina <ton.email@gmail.com>

# Copie supplémentaire des alertes admin (optionnel, e-mails séparés par virgule)
# MAIL_ADMIN_COPY=responsable.it@poulina.tn
